# .dockerignore — build-context filter for the multi-stage Dockerfile.
# The Dockerfile regenerates frontend node_modules + dist inside the image, so
# the host copies must never be sent. This also fixes the BuildKit crash
# "readlink frontend/node_modules/.bin/...: operation not permitted" caused by
# the broken symlinks on the local dev mount.

# --- node / frontend build output (regenerated by stage 1: npm ci + build) ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
coverage/

# --- Go build output (stage 2 builds to /out inside the image) ---
bin/

# --- version control / editor / temp ---
.git/
.gitignore
.dockerignore
Dockerfile
.opencode-worktrees/
.idea/
.vscode/
*.swp
*.tmp

# --- logs & local marker files ---
*.log
frontend/npm.log
frontend/NPM_DONE

# --- local runtime state dirs (if ever created under this root) ---
netsidian-state/
*.state/

# NOTE — deliberately NOT ignored (stage-2 `COPY . .` needs them to compile):
# go.mod, go.sum, main.go, **/*.go, internal/  (incl. internal/repository/
# sqlite/migrations/*.sql embedded via //go:embed at db.go L16)
# and the frontend SOURCE kept for stage 1: frontend/package.json,
# frontend/package-lock.json, frontend/index.html, frontend/vite.config.ts,
# frontend/tsconfig.json, frontend/src/**.
